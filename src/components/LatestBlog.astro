---
import Button from "./Button.astro";
---

<!-- Hidden until the post arrives; if the request fails, it stays hidden (same as before) -->
<section class="latest-blog" id="blog" hidden>
  <h2 class="section-title">Registro 06 - Blog</h2>
  <p class="blog-label"><span class="star">✦</span> ÚLTIMO ARTÍCULO</p>

  <div class="blog-card">
    <div class="blog-header">
      <span class="pill" data-blog-tag></span>
      <span class="blog-date" data-blog-date></span>
    </div>

    <h3 data-blog-title></h3>

    <p data-blog-description></p>

    <a
      href="https://bit-a-bitacora.vercel.app"
      class="read-more"
      target="_blank"
      rel="noopener noreferrer"
      data-blog-link
    >
      <Button name="Leer artículo →" class="btn-project" />
    </a>
  </div>
</section>

<script>
  interface BlogPost {
    title: string;
    description: string;
    date: string;
    tag: string;
    url: string;
  }

  const BLOG_API = "https://bit-a-bitacora.vercel.app/api/latest.json";

  async function loadLatestPost() {
    const section = document.querySelector<HTMLElement>(".latest-blog");
    if (!section) return;

    try {
      const response = await fetch(BLOG_API);
      if (!response.ok) return;

      const post: BlogPost = await response.json();

      const tag = section.querySelector<HTMLElement>("[data-blog-tag]");
      const date = section.querySelector<HTMLElement>("[data-blog-date]");
      const title = section.querySelector<HTMLElement>("[data-blog-title]");
      const description = section.querySelector<HTMLElement>("[data-blog-description]");
      const link = section.querySelector<HTMLAnchorElement>("[data-blog-link]");

      if (tag) tag.textContent = post.tag;
      if (date) {
        date.textContent = new Date(post.date).toLocaleDateString("es-ES", {
          day: "numeric",
          month: "short",
          year: "numeric",
        });
      }
      if (title) title.textContent = post.title;
      if (description) {
        description.textContent = post.description;
        description.hidden = !post.description;
      }
      if (link) link.href = post.url;

      section.hidden = false;
    } catch (error) {
      console.error("No se pudo cargar la última entrada del blog:", error);
    }
  }

  loadLatestPost();
</script>