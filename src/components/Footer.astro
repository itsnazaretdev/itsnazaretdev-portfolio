---
import { navLinks, socialLinks } from "../data/nav.js";
---

<footer>
  <div class="top">
    <div>
      <p class="personal">itsnazaretdev</p>
      <p>Estudiante de DAW construyendo cosas con cuidado.</p>
    </div>

    <div>
      <p class="sites">Sitios</p>
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="links">Enlaces</p>
      <ul>
        {socialLinks.map((link) => (
          <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  footer {
    width: 100%;
    margin: 12rem auto;
    display: flex;
    flex-direction: column;
    padding: 2rem 0;
    border-top: 1px dashed var(--border-strong);
  }

  .top {
    width: 55%;
    margin: 0 auto;
   display: flex;
   justify-content: space-between;
    gap: 20px;
  }

  .personal, .sites, .links {
    font-family: var(--cascadia);
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

    ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  a:hover {
    color: var(--text-primary);
  }
</style>