---
interface Props {
  numero: number;
  titulo: string;
  descripcion: string;
  puntos: string[];
  imagen: string;
  tags: string[];
  repoUrl: string;
  style?: string;
}

const { numero, titulo, descripcion, puntos, imagen, tags, repoUrl, style } = Astro.props;
---

<div class="stack-card" data-i={numero - 1} style={style}>
  <div class="card-image">
    <img src={imagen} alt={titulo} />
  </div>

  <div class="card-content">
    <span class="card-number">PROYECTO {String(numero).padStart(2, '0')}</span>
    <h3>{titulo}</h3>
    <p>{descripcion}</p>

    {puntos && puntos.length > 0 && (
      <ul class="puntos-list">
        {puntos.map((punto) => <li>{punto}</li>)}
      </ul>
    )}

    <div class="card-meta">
      {tags.map((tag) => <span>{tag}</span>)}
    </div>

    <div class="acciones">
      <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="boton">
        Repositorio →
      </a>
    </div>
  </div>
</div>

<style>
  .stack-card {
    position: sticky;
    top: calc(90px + (var(--card-index, 0) * 45px));
    min-height: 480px;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 38px;
    align-items: center;
    padding: 28px;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.3);
    border-radius: 34px;
    background: var(--surface, #1e1e1e);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    
    /* Reglas clave para la animación del script */
    transform: scale(var(--scale, 1));
    transform-origin: top center;
    will-change: transform;
  }

  .card-image {
    height: 100%;
    min-height: 380px;
    border-radius: 22px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-content {
    padding: 10px 10px 10px 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card-number {
    font-family: var(--cascadia, monospace);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--text-muted, #a1a1aa);
  }

  h3 {
    font-size: clamp(26px, 3.5vw, 48px);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0;
  }

  p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary, #d4d4d8);
    margin: 0;
  }

  .puntos-list {
    font-size: 0.85rem;
    color: var(--text-secondary, #d4d4d8);
    padding-left: 1.2rem;
    margin: 0.2rem 0;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 0.4rem;
  }

  .card-meta span {
    padding: 6px 14px;
    border-radius: 100px;
    background: var(--surface-light, rgba(255, 255, 255, 0.08));
    border: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.75rem;
    font-family: var(--cascadia, monospace);
  }

  .acciones {
    margin-top: 0.8rem;
  }

  .boton {
    display: inline-block;
    font-family: var(--cascadia, monospace);
    font-size: 0.8rem;
    background: var(--text-primary, #fff);
    color: var(--surface, #121212);
    padding: 10px 20px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .stack-card {
      gap: 24px;
      padding: 22px;
      min-height: 400px;
    }
    .card-image {
      min-height: 300px;
    }
  }

  @media (max-width: 680px) {
    .stack-card {
      position: relative;
      top: auto !important;
      grid-template-columns: 1fr;
      min-height: auto;
      padding: 20px;
      transform: none !important;
      margin-bottom: 2rem;
    }

    .card-image {
      height: 200px;
      min-height: 0;
    }
  }
</style>