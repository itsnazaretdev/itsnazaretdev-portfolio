---
const { name, color } = Astro.props;

const defaultColors = {
  javascript: "#fff1c7",
  java: "#c7f4ff",
 python: "#b3c8de",
  sql: "#e2f7cf",
  react: "#beeffd",
  node: "#c1edaf",
  html: "#fbc3b5",
  css: "#b8c4f8",
  typescript: "#abcbf2",
  api: "#9eeed6",
  "api rest": "#9eeed6",
  swing: "#d7c0fb",
  opencv: "#a1cadf"
};

const key = typeof name === "string" ? name.toLowerCase().trim() : "";
const pillColor = color ?? defaultColors[key as keyof typeof defaultColors] ?? "#3b82f6";
---

<span class="pill">{ name }</span>

<style define:vars={{ color: pillColor }}>
    .pill {
        font-family: var(--cascadia);
        font-size: var(--text);
        border-radius: 0.8rem;
        padding: 0.2rem 0.6rem;
        background-color: var(--color);
        color: hsl(from var(--color) h s 20%);
    }

</style>