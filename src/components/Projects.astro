---
import { proyectos } from '../data/proyectos.js';
import ProjectPanel from './ProjectPanel.astro';
---

<section id="proyectos">
  <div class="indicador">
    <span class="contador">01 / {String(proyectos.length).padStart(2, '0')}</span>
    <div class="puntos">
      {proyectos.map((_, i) => <span class="punto" data-i={i}></span>)}
    </div>
  </div>

  <div class="cards">
    {proyectos.map((p, index) => (
      <ProjectPanel {...p} style={`--card-index: ${index};`} />
    ))}
  </div>
</section>

<style>
  #proyectos {
    position: relative;
    max-width: 1120px;
    margin: 0 auto;
    padding: 40px 20px 140px;
  }

  .indicador {
    position: sticky;
    top: 20px;
    z-index: 100;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    padding: 8px 16px;
    backdrop-filter: blur(10px);
    background: rgba(0, 0, 0, 0.4);
    border-radius: 100px;
    width: fit-content;
    margin-left: auto;
    margin-bottom: 40px;
  }

  .contador {
    font-family: var(--cascadia, monospace);
    font-size: 0.8rem;
    color: var(--text-secondary, #ccc);
  }

  .puntos {
    display: flex;
    gap: 6px;
  }

  .punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border, #444);
    transition: all 0.25s ease;
  }

  .punto.activo {
    background: var(--text-primary, #fff);
    transform: scale(1.4);
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 50px;
    padding-bottom: 120px;
  }

  @media (max-width: 680px) {
    .cards {
      gap: 0;
      padding-bottom: 0;
    }
  }
</style>

<script>
  function initStackAnimation() {
    const cards = document.querySelectorAll<HTMLElement>('.stack-card');
    const puntos = document.querySelectorAll('.punto');
    const contador = document.querySelector('.contador');
    const total = cards.length;

    if (!cards.length) return;

    function updateCardScale() {
      let actual = 0;

      cards.forEach((card, index) => {
        const rect = card.getBoundingClientRect();
        
        // Algoritmo exacto de tu ejemplo original de HTML/JS
        const progress = Math.min(Math.max((120 - rect.top) / 300, 0), 1);
        const scale = 1 - progress * 0.035;
        card.style.setProperty('--scale', scale.toFixed(3));

        // Actualizar el índice del proyecto activo
        if (rect.top <= 250) {
          actual = index;
        }
      });

      puntos.forEach((punto) => {
        const i = parseInt(punto.getAttribute('data-i') || '0');
        punto.classList.toggle('activo', i === actual);
      });

      if (contador) {
        contador.textContent = `${String(actual + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
      }
    }

    updateCardScale();
    window.addEventListener('scroll', updateCardScale, { passive: true });
  }

  // Ejecutar inmediatamente y tras navegaciones de Astro (View Transitions)
  initStackAnimation();
  document.addEventListener('astro:page-load', initStackAnimation);
</script>