---
import { projects } from '../data/projects.js';
import CardProject from './CardProject.astro';
---

<section id="projects">
  <ol class="cards">
    {projects.map((p, index) => (
      <CardProject {...p} style={`--card-index: ${index};`} />
    ))}
  </ol>
</section>

<style>
  section {
    width: 65%;
    margin: 0 auto;
    padding: 2.5rem 0 8.75rem 0;
    padding-top: 6.5rem;
  }

  .cards {
    padding: 0 0 7.5rem;
    display: flex;
    flex-direction: column;
    gap: 3.125rem;
  }

  @media (max-width: 680px) {
    section {
      width: calc(100% - 2rem);
    }

    .cards {
      gap: 0;
      padding-bottom: 0;
    }
  }
</style>

<script>
  function initStackAnimation() {
    const cards = document.querySelectorAll<HTMLElement>('.card');
    if (!cards.length) return;

    function updateCardScale() {
      cards.forEach((card) => {
        const rect = card.getBoundingClientRect();
        const progress = Math.min(Math.max((120 - rect.top) / 300, 0), 1);
        const scale = 1 - progress * 0.035;
        card.style.setProperty('--scale', scale.toFixed(3));
      });
    }

    updateCardScale();
    window.addEventListener('scroll', updateCardScale, { passive: true });
  }

  initStackAnimation();
  document.addEventListener('astro:page-load', initStackAnimation);
</script>