---
const { name, class: className } = Astro.props;
---

<button class={className}>{ name }</button>

<style is:global>
    button {
        padding: 0.6rem 1.2rem;
        font-family: var(--cascadia);
        border-radius: 0.3rem;
        border: none;
    }
    
    .btn-project {
        color: white;
        background-color: #000;
    }

    .btn-contact {
        color: black;
        background-color: #ededed;
    }
</style>