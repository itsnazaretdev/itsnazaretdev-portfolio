
<header>
    <a href="#hero"><img src="/src/assets/icoLight.png" alt="Logo portfolio NZ" class="logo-light"></a>
    <a href="#hero"><img src="/src/assets/icoDark.png" alt="Logo portfolio NZ" class="logo-dark"></a>

    <nav>
        <ul>
            <li><a href="#projects">Proyectos</a></li>
            <li><a href="">Skills</a></li>
            <li><a href="">Sobre mí</a></li>
            <li><a href="">Contacto</a></li>
        </ul>
    </nav>

    <button>⏾</button>
</header>

<style>
    header {
        width: 100%;
        height: 4rem;
        padding: 0 2rem;
        display: flex;
        justify-content: center;
        align-items: center;
        position: fixed;
        top: 0;
        left: 0;
        color: var(--text-primary);
        z-index: 1;
        backdrop-filter: blur(12px);
        transition: transform 0.3s ease;
    }

    header.hidden {
        transform: translateY(-100%);
    }

    .logo-dark {
        display: none;
    }

    html.dark .logo-light {
        display: none;
    } 

    html.dark .logo-dark {
        display: inline-block;
    }

    img {
        width: 3rem;
    }

    nav {
        width: 100%;
    }

    nav ul {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 3rem;
        list-style: none;
    }
    
    li {
        font-family: var(--cascadia);
        font-size: var(--text);
        color: var(--text-primary);
    }

    button {
        width: 3rem;
        color: inherit;
        font-size: var(--btn-theme);
        border: none;
        background-color: transparent;
        cursor: pointer;
    }

</style>

<script>
   document.addEventListener("DOMContentLoaded", () => {
    const button = document.querySelector("button");
    const header = document.querySelector("header");

    if (button) {
        button.addEventListener("click", () => {
            const isDark = document.documentElement.classList.toggle("dark");
            button.textContent = isDark ? "☀︎" : "⏾";
        });
    }

    if (header) {
        let lastScroll = 0;

        window.addEventListener(
            "scroll",
            () => {
                const currentScroll = window.scrollY;

                if (currentScroll < 80) {
                    header.classList.remove("hidden");
                } else if (currentScroll > lastScroll) {
                    header.classList.add("hidden");
                } else {
                    header.classList.remove("hidden");
                }

                lastScroll = currentScroll;
            },
            { passive: true }
        );
    }
});
</script>