---
import Button from "./Button.astro"
import Pill from "./Pill.astro"

interface Props {
  number: number;
  title: string;
  description: string;
  listItems: string[];
  img: string;
  pills: string[];
  urlRepo: string;
  style?: string;
}

const { number, title, description, listItems = [], img, pills = [], urlRepo, style } = Astro.props;
---

<li class="card" style={style}>
    <span>proyecto nº {String(number).padStart(2, '0')}</span>

    <article>
        <figure>
            <img src={img} alt={`Captura de ${title}`} />
        </figure>

        <div class="info-project">
            <h2>{title}</h2>
            <p>{description}</p>
    
            <ul class="ul-listItems">
                {listItems.map((item) => <li class="li-listItem">{item}</li>)}
            </ul>
    
            <ul class="pill-list">
                {pills.map((pill) => <li class="li-pill"><Pill name={pill} /></li>)}
            </ul>
    
            <a href={urlRepo} target="_blank" rel="noopener noreferrer"><Button name="Repositorio ->" class="btn-project"/></a>
        </div>
    </article>
</li>

<style>
    li {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    span {
        font-family: var(--cascadia);
    }

    .card {
        list-style: none;
        position: sticky;
        top: calc(4rem + (var(--card-index, 0) * 45px));
        transform-origin: top center;
        will-change: transform;
        padding: 1.5rem;
        border-radius: 10px;
        background-color: #ededed;
        border-top: 1px solid rgb(210, 208, 208);
    }

    article {
        display: flex;
        gap: 2rem;
    }

    figure {
        height: 100%;
    }

    figure img {
        width: 25rem;
        height: 100%;
        border-radius: 10px;
    }

    .info-project {
        display: flex;
        flex-direction: column;
        gap: .6rem;
    }

    .ul-listItems {
        padding-left: .9rem;
    }

    .li-listItem {
        display: list-item;
        list-style: circle;
    }

    .pill-list {
        display: flex;
        gap: .3rem;
    }

    .li-pill {
        display: block;
    }


    @media (max-width: 900px) {
        article {
            gap: 1.2rem;
        }

        figure img {
            width: 18rem;
        }
    }

    @media (max-width: 680px) {
        .card {
            position: static;
            top: auto;
            padding: 1rem;
        }

        article {
            flex-direction: column;
            gap: 1rem;
        }

        figure img {
            width: 100%;
            height: 12rem;
        }
    }
</style>