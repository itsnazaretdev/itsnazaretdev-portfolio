---
import Button from "./Button.astro"
import GmailIcon from "./icons/GmailIcon.astro"
import LinkedInIcon from "./icons/LinkedInIcon.astro"
import GitHubIcon from "./icons/GitHubIcon.astro"
import SocialMedia from "./SocialMedia.astro"
---

<section id="hero">
    <img class="animate-slide-in-top" src="/logo-me.png" alt="Personal image">

    <div class="info">
        <h2>Registro 01 — Desarrolladora DAW</h2>
        <h1 class="animate-blurred-fade-in">Nazaret</h1>
        <p class="animate-blurred-fade-in delay-200">Construyo aplicaciones con la misma atencion al detalle con la que organizo una estanteria: cada pieza en su sitio, cada dato con su etiqueta.</p>
        
        <div class="btns animate-blurred-fade-in delay-400"> 
            <div class="social-links"> 
                <SocialMedia icon={GitHubIcon} label="GitHub" href="https://github.com/..." /> 
                <SocialMedia icon={LinkedInIcon} label="LinkedIn" href="https://linkedin.com/..." /> 
                <SocialMedia icon={GmailIcon} label="Escríbeme" emailUser="nazaretgutirrezmartn" emailDomain="gmail.com" /> 
            </div> 
            
            <a href="#projects"> <Button name="Ver proyectos ->" class="btn-project" /></a> 
        </div>
    </div>
    

</section>

<style>
    section {
        width: 50%;
        height: 100vh;
        margin: 0 auto;
        padding-bottom: 4rem;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 4rem;
    }
    
    
    .info {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    
    p {
        width: 30rem;
    }
    
    .stack-container {
        width: 15rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    img {
        width: 16rem;
        object-fit: cover;
    }

    .btns { 
        display: flex; 
        flex-direction: column; 
        align-items: flex-start; 
        gap: 1rem; 
    } 
    
    .social-links { 
        display: flex; 
        align-items: center; 
        gap: 1rem; 
    }
</style>