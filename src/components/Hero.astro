---
import Button from "./Button.astro"
---

<section id="hero">
    <img class="animate-slide-in-top" src="/src/assets/logo.png" alt="Personal image">

    <div class="info">
        <h3>registro 01 — desarrolladora daw</h3>
        <h1 class="animate-blurred-fade-in">Nazaret</h1>
        <p class="animate-blurred-fade-in delay-200">Construyo aplicaciones con la misma atencion al detalle con la que organizo una estanteria: cada pieza en su sitio, cada dato con su etiqueta.</p>
        
        <div class="btns animate-blurred-fade-in delay-400">
            <a href="#projects"><Button name="Ver proyectos ->" class="btn-project"/></a>
            <a href="#contact"><Button name="Contacto" class="btn-contact"/></a>
        </div>
    </div>
    

</section>

<style>
    section {
        width: 50%;
        height: 100vh;
        margin: 0 auto;
        padding-bottom: 4rem;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 4rem;
    }
    
    h3 {
        font-family: var(--cascadia);
        font-weight: 100;
        font-size: var(--h3);
    }
    
    .info {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    
    p {
        width: 30rem;
    }
    
    .stack-container {
        width: 15rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    img {
        width: 16rem;
        object-fit: cover;
    }

    .btns {
        display: flex;
        gap: 1rem;
    }
</style>