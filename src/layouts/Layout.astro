---
import '@fontsource-variable/nunito-sans/wght.css';
import '@fontsource-variable/cascadia-code/wght.css';
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/icoLight.png" type="image/svg+xml" media="(prefers-color-scheme: light)" />
		<link rel="icon" href="/icoDark.png" media="(prefers-color-scheme: dark)" />
		<title>Nazaret | Portfolio</title>
	</head>
	<body>
		<div class="bg-hero"></div>
		<slot />
	</body>
</html>

<script>
	const DURATION = 900;
	const easeInOutCubic = (t: number) =>
		t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

	document.addEventListener("click", (e) => {
		const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
		if (!link) return;

		const id = link.getAttribute("href")!.slice(1);
		const target = id ? document.getElementById(id) : null;
		if (!target) return;

		e.preventDefault();

		const offset = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
		const endY = target.getBoundingClientRect().top + window.scrollY - offset;
		history.pushState(null, "", `#${id}`);

		// Como en un enlace nativo, el foco pasa a la sección (teclado y lectores de pantalla)
		const moveFocus = () => {
			if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
			target.focus({ preventScroll: true });
		};

		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			window.scrollTo(0, endY);
			moveFocus();
			return;
		}

		const startY = window.scrollY;
		const distance = endY - startY;
		const start = performance.now();

		// Desactiva el smooth nativo para que no compita con la animación
		document.documentElement.style.scrollBehavior = "auto";

		const step = (now: number) => {
			const progress = Math.min((now - start) / DURATION, 1);
			window.scrollTo(0, startY + distance * easeInOutCubic(progress));
			if (progress < 1) {
				requestAnimationFrame(step);
			} else {
				document.documentElement.style.scrollBehavior = "";
				moveFocus();
			}
		};
		requestAnimationFrame(step);
	});
</script>

<style is:global>
	html {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
		color-scheme: light dark;
	}

	/* Secciones enfocadas por los enlaces del menú: sin anillo al usar ratón */
	[tabindex="-1"]:focus:not(:focus-visible) {
		outline: none;
	}

	body {
		background-color: var(--bg-color);
		color: var(--text-primary);
	}
	
.bg-hero {
  position: fixed;
  top: 0;
  left: 0;
  z-index: -2;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  transition: background-color 0.3s ease, background-image 0.3s ease;
  background-color: var(--bg-color);
  background-image: radial-gradient(
    ellipse 80% 80% at 50% -20%,
    var(--glow-color),
    var(--glow-fade)
  );
}

</style>
