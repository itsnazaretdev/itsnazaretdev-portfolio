---
import '@fontsource-variable/nunito-sans/wght.css';
import '@fontsource-variable/cascadia-code/wght.css';
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/src/assets/icoLight.png" type="image/svg+xml" media="(prefers-color-scheme: light)" />
		<link rel="icon" href="/src/assets/icoDark.png" media="(prefers-color-scheme: dark)" />
		<title>Nazaret | Portfolio</title>
	</head>
	<body>
		<div class="bg-hero"></div>
		<slot />
	</body>
</html>

<style is:global>
	html {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
		color-scheme: light dark;
	}

	body {
		background-color: var(--bg-color);
		color: var(--text-primary);
	}
	
.bg-hero {
  position: fixed;
  top: 0;
  left: 0;
  z-index: -2;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  transition: background-color 0.3s ease, background-image 0.3s ease;
  background-color: var(--bg-color);
  background-image: radial-gradient(
    ellipse 80% 80% at 50% -20%,
    var(--glow-color),
    var(--glow-fade)
  );
}

</style>
